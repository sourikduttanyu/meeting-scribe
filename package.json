{
  "name": "meeting-scribe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "test": "node --test \"server/**/*.test.ts\"",
    "typecheck": "tsc",
    "check": "npm run typecheck && npm test",
    "scenario": "node server/testing/scenario-cli.ts",
    "e2e:call": "node server/testing/e2e-call.ts",
    "e2e:scribe": "node server/testing/e2e-scribe.ts",
    "start": "node server/main.ts",
    "dev": "NODE_ENV=development node --watch server/main.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "opusscript": "^0.1.1",
    "werift": "^0.24.4",
    "ws": "^8.21.3"
  }
}
